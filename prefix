#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

int isOperator(char c) {
    return c == '+' || c == '-' || c == '*' || c == '/';
}

int getPrecedence(char op) {
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0; 
}

void reverseString(char* str) {
    int i = 0, j = strlen(str) - 1;
    while (i < j) {
        char temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }
}

int isValidInfix(const char* exp) {
    int balance = 0;
    int prev_type = 0; 
    int operand_count = 0;
    int operator_count = 0;
    int len = strlen(exp);

    if (len == 0) return 0;

    for (int i = 0; i < len; i++) {
        char c = exp[i];
        if (c == '(') {
            if (prev_type == 1) return 0; 
            balance++;
            prev_type = 0;
        } else if (c == ')') {
            if (prev_type == 0) return 0; 
            balance--;
            if (balance < 0) return 0;
            prev_type = 1;
        } else if (isalnum(c)) {
            if (prev_type == 1) return 0; 
            operand_count++;
            prev_type = 1;
        } else if (isOperator(c)) {
            if (prev_type == 0) return 0; 
            operator_count++;
            prev_type = 0;
        } else {
            return 0; 
        }
    }
    if (balance != 0) return 0; 
    if (prev_type != 1) return 0;  
    if (operand_count != operator_count + 1) return 0; 
    return 1;
}

void infixToPrefix(const char* exp) {
    if (!isValidInfix(exp)) {
        printf("ERROR\n");
        return;
    }

    int len = strlen(exp);
    char stack[256];
    int top = -1;
    char temp[256];
    int t_idx = 0;

    for (int i = len - 1; i >= 0; i--) {
        char c = exp[i];
        if (isalnum(c)) {
            temp[t_idx++] = c;
        } else if (c == ')') {
            stack[++top] = c;
        } else if (c == '(') {
            while (top >= 0 && stack[top] != ')') {
                temp[t_idx++] = stack[top--];
            }
            if (top >= 0 && stack[top] == ')') {
                top--; 
            }
        } else if (isOperator(c)) {
            while (top >= 0 && stack[top] != ')' && getPrecedence(stack[top]) > getPrecedence(c)) {
                temp[t_idx++] = stack[top--];
            }
            stack[++top] = c; 
        }
    }
    
    while (top >= 0) {
        temp[t_idx++] = stack[top--];
    }
    temp[t_idx] = '\0';
    
    reverseString(temp);
    printf("%s\n", temp);
}

void prefixToInfix(const char* exp) {
    int len = strlen(exp);
    char stack[256][512]; 
    int top = -1;

    for (int i = len - 1; i >= 0; i--) {
        char c = exp[i];
        if (isalnum(c)) {
            char operand[2] = {c, '\0'};
            top++;
            strcpy(stack[top], operand);
        } else if (isOperator(c)) {
            if (top < 1) {
                printf("ERROR\n");
                return;
            }
            char op1[512], op2[512];
            strcpy(op1, stack[top--]);
            strcpy(op2, stack[top--]);

            char combined[512];
            sprintf(combined, "(%s%c%s)", op1, c, op2);
            
            top++;
            strcpy(stack[top], combined);
        } else {
            printf("ERROR\n");
            return;
        }
    }
    
    if (top != 0) {
        printf("ERROR\n");
    } else {
        printf("%s\n", stack[0]);
    }
}

int main() {
    int mode;
    char exp[256];
    
    if (scanf("%d %s", &mode, exp) != 2) {
        return 0;
    }
    
    if (mode == 1) {
        infixToPrefix(exp);
    } else if (mode == 2) {
        prefixToInfix(exp);
    }
    
    return 0;
}
