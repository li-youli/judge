#include <stdio.h>

int fib_recurrence(int n);

int main(void){
    int n;
    if(scanf("%d",&n)!=1) return 0;
    
    for(int i=0;i<=n;i++){
        printf("%10d",fib_recurrence(i));
    }
    printf("\n");
    
    int first=0; int second = 1; int next=0;
    for (int i=0; i<=n; i++){
        if(i==0) {
            printf("0 ");
        }
        else if(i==1) {
            printf("1 ");
        }   
        else{
            next = first + second;
            printf("%10d",next);
            first = second;
            second = next;
        }    
    }
    printf("\n");
    return 0;
}

int fib_recurrence(int n){
    if(n==0) return 0;
    if(n==1) return 1;
    return fib_recurrence(n-1)+fib_recurrence(n-2); 
}
