#include <stdio.h>
#include <string.h>

int get_precedence(char op) {
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0; 
}

int is_valid_infix(const char* exp) {
    int balance = 0;
    int state = 0; 
    int len = strlen(exp);
    
    if (len == 0) return 0;
    
    for (int i = 0; i < len; i++) {
        char c = exp[i];
        if (c >= 'A' && c <= 'Z') {
            if (state != 0) return 0;
            state = 1;
        } else if (c == '+' || c == '-' || c == '*' || c == '/') {
            if (state != 1) return 0;
            state = 0;
        } else if (c == '(') {
            if (state != 0) return 0;
            balance++;
        } else if (c == ')') {
            if (state != 1) return 0; 
            balance--;
            if (balance < 0) return 0; 
        } else {
            return 0; 
        }
    }
    return (state == 1 && balance == 0);
}

void infix_to_postfix(const char* exp) {
    if (!is_valid_infix(exp)) {
        printf("ERROR\n");
        return;
    }

    int len = strlen(exp);
    char stack[256];
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char c = exp[i];
        if (c >= 'A' && c <= 'Z') {
            printf("%c", c);
        } else if (c == '(') {
            stack[++top] = c;
        } else if (c == ')') {
            while (top >= 0 && stack[top] != '(') {
                printf("%c", stack[top--]);
            }
            if (top >= 0 && stack[top] == '(') {
                top--; 
            }
        } else if (c == '+' || c == '-' || c == '*' || c == '/') {
            while (top >= 0 && get_precedence(stack[top]) >= get_precedence(c)) {
                printf("%c", stack[top--]);
            }
            stack[++top] = c;
        }
    }
    
    while (top >= 0) {
        printf("%c", stack[top--]);
    }
    printf("\n");
}

void postfix_to_infix(const char* exp) {
    int len = strlen(exp);
    char stack[256][512]; 
    int top = -1;

    for (int i = 0; i < len; i++) {
        char c = exp[i];
        if (c >= 'A' && c <= 'Z') {
            char temp[2] = {c, '\0'};
            strcpy(stack[++top], temp);
        } else if (c == '+' || c == '-' || c == '*' || c == '/') {
            if (top < 1) {
                printf("ERROR\n");
                return;
            }
            char right[512], left[512];
            strcpy(right, stack[top--]);
            strcpy(left, stack[top--]);
            
            sprintf(stack[++top], "(%s%c%s)", left, c, right);
        } else {
            printf("ERROR\n");
            return;
        }
    }

    if (top != 0) {
        printf("ERROR\n");
    } else {
        printf("%s\n", stack[0]);
    }
}

int main() {
    int mode;
    char exp[256];
    
    if (scanf("%d %s", &mode, exp) != 2) {
        return 0;
    }
    
    if (mode == 1) {
        infix_to_postfix(exp);
    } else if (mode == 2) {
        postfix_to_infix(exp);
    }
    
    return 0;
}
