#include <stdio.h>

int main() {
    int mode;
    if (scanf("%d", &mode) != 1) return 0;

    int A[3][3];
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            scanf("%d", &A[i][j]);
        }
    }

    if (mode == 1) {
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                printf("%d%c", A[j][i], (j == 2) ? '\n' : ' ');
            }
        }
    } else if (mode == 2) {
        int B[3][3], C[3][3];
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                scanf("%d", &B[i][j]);
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                scanf("%d", &C[i][j]);
            }
        }

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                int val = C[i][j];
                for (int k = 0; k < 3; k++) {
                    val += A[i][k] * B[k][j];
                }
                printf("%d%c", val, (j == 2) ? '\n' : ' ');
            }
        }
    }
    return 0;
}
